# Expectations for ts/build/verify-image --profile thinpro.
#
# The session this profile boots into, and the binaries without which it
# boots to a bare root window or not at all. tp-session starts the rest; it
# checks for each with `which` and quietly skips what is missing, so an image
# without tp-taskbar still boots and simply has no taskbar -- which is why
# they are listed here rather than trusted to fail loudly at runtime.

EXPECT_SESSION=openbox

# kwin_x11 is the window manager; openbox is its fallback. horizon-client is
# the Omnissa client (a CI run without the RPM drops it from this list).
REQUIRE_BIN="openbox kwin_x11 xprop tp-session tpreg tp-connmgr tp-controlpanel tp-panel tp-taskbar tp-wizard xsetroot horizon-client tp-hwreport tp-diag tp-diag-send logger"
