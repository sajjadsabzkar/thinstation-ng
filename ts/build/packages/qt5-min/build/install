#!/bin/sh

# Just enough Qt5 to run a Widgets application. The existing qt5-base package
# also pulls QML, multimedia, sensors, serialport, websockets, xmlpatterns and
# the Designer/Help libraries, none of which a widgets-only client needs, and
# on ThinPro the full Qt5 stack measures ~107 MB installed.
#
# Keep qt5-base for anything that genuinely needs QML.

export PACKAGE="qt5-min"
export PORTS="
qt-settings
qt5-filesystem
qt5-qtbase
qt5-qtbase-common
qt5-qtbase-gui
qt5-qtsvg
qt5-qtx11extras
"
export DROP_FILES=""
export DROP_DIRS=""
export CREATE_EMPTY_DIRS=""
repackage -e

returnval=$?

exit $returnval
