# Sourced by every /etc/tp/panels/*.apply hook.
#
# Deliberately tiny: the hooks run as often as someone clicks Apply, and on a
# 1 GB client that is not the place to source thinstation.global and drag in
# the whole runtime environment.

is_true() {
	case "`echo "$1" | tr 'A-Z' 'a-z'`" in
	1|on|true|yes|enabled)	return 0 ;;
	*)			return 1 ;;
	esac
}

# Writes KEY=value into $TS_RUNTIME so the rest of the ThinStation runtime
# sees what the control panel changed. The runtime file is append-only by
# convention, so drop any earlier line for the same key first.
runtime_set() {
	key="$1"
	value="$2"
	file="${TS_RUNTIME:-/etc/thinstation.runtime}"

	[ -w "`dirname $file`" ] || return 0
	if [ -e "$file" ]; then
		grep -v "^${key}=" "$file" > "$file.tmp" 2>/dev/null
		mv "$file.tmp" "$file"
	fi
	echo "${key}=${value}" >> "$file"
}

# Tells a running tp-session to re-read the product configuration, so that
# switching to or from kiosk takes effect without logging out. tp-session
# writes its pid under /var/lib/tp/tmp, which the session user owns; /run is
# root's and the session could never have created a file there.
notify_session() {
	pidfile=/var/lib/tp/tmp/session.pid
	[ -e "$pidfile" ] || return 0
	pid=`cat $pidfile 2>/dev/null`
	# A pid file left behind by a session that died can name some other
	# process by now, and SIGUSR1 terminates anything that does not trap it.
	grep -q tp-session "/proc/$pid/cmdline" 2>/dev/null || return 0
	kill -USR1 "$pid" 2>/dev/null
	return 0
}
