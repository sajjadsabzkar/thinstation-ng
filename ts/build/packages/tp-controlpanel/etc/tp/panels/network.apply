#!/bin/sh
# Applies root/network/* .
#
# Deliberately conservative. Changing addressing on a thin client can cut the
# only path back to it, so this writes the runtime layer that ThinStation's
# own network scripts read and reconfigures the interface in place, rather
# than restarting networking wholesale.

. /etc/tp/panels/common 2>/dev/null

HOST=`tpreg get root/network/hostname`
METHOD=`tpreg get root/network/method`
ADDR=`tpreg get root/network/address`
MASK=`tpreg get root/network/netmask`
GW=`tpreg get root/network/gateway`
DNS1=`tpreg get root/network/dns1`
DNS2=`tpreg get root/network/dns2`

if [ -n "$HOST" ]; then
	hostname "$HOST" 2>/dev/null
	runtime_set NETWORK_HOSTNAME "$HOST"
fi

DEV=`ip -o route show default 2>/dev/null | awk '{print $5; exit}'`
[ -n "$DEV" ] || DEV=`ip -o link show 2>/dev/null | awk -F': ' '$2!="lo" {print $2; exit}'`

case "$METHOD" in
static)
	if [ -z "$ADDR" ]; then
		echo "Static addressing needs an IP address." >&2
		exit 1
	fi
	runtime_set NET_USE_DHCP off
	runtime_set NET_IP_ADDRESS "$ADDR"
	runtime_set NET_MASK "$MASK"
	runtime_set NET_GATEWAY "$GW"

	if [ -n "$DEV" ]; then
		prefix=`ipcalc -p "$ADDR" "${MASK:-255.255.255.0}" 2>/dev/null | cut -d= -f2`
		[ -n "$prefix" ] || prefix=24
		ip addr flush dev "$DEV" 2>/dev/null
		ip addr add "$ADDR/$prefix" dev "$DEV" 2>/dev/null
		ip link set "$DEV" up 2>/dev/null
		[ -n "$GW" ] && ip route replace default via "$GW" dev "$DEV" 2>/dev/null
	fi
	;;
dhcp|"")
	runtime_set NET_USE_DHCP on
	# Leave the running lease alone; a renewal is the caller's business.
	;;
esac

if [ -n "$DNS1$DNS2" ] && [ -w /etc/resolv.conf -o -w /etc ]; then
	{
		echo "# generated by /etc/tp/panels/network.apply"
		[ -n "$DNS1" ] && echo "nameserver $DNS1"
		[ -n "$DNS2" ] && echo "nameserver $DNS2"
	} > /etc/resolv.conf 2>/dev/null
	runtime_set NET_DNS1 "$DNS1"
	runtime_set NET_DNS2 "$DNS2"
fi

exit 0
