#!/bin/sh
# Applies root/usb/* -- whether a USB device stays on the client or is handed
# to the remote session, and which device classes are allowed at all.
#
# ThinPro does this with hptc-usb-mgr writing Manticore keys that the udev
# rules and each protocol's launcher read back. Same split here: this hook
# only writes the two files those consumers read, and never touches a device
# directly. Unplugging and replugging is what re-evaluates a device, exactly
# as on ThinPro.

. /etc/tp/panels/common 2>/dev/null

PROTOCOL=`tpreg get root/usb/protocol`
[ -n "$PROTOCOL" ] || PROTOCOL=local

RULES=/run/tp-usb.rules
CONF=/run/tp-usb.conf

# 1. The class allow-list, consumed by the udev rule shipped with this
#    package. Written to /run because the image root is read-only.
{
	echo "# generated by /etc/tp/panels/usb.apply -- do not edit"
	echo "TP_USB_PROTOCOL=$PROTOCOL"
	for pair in massStorage:08 printer:07 audio:01 smartcard:0b other:ff; do
		name=`echo $pair | cut -d: -f1`
		class=`echo $pair | cut -d: -f2`
		value=`tpreg get "root/usb/class/$name"`
		if is_true "$value"; then
			echo "TP_USB_CLASS_${class}=allow"
		else
			echo "TP_USB_CLASS_${class}=deny"
		fi
	done
	if is_true "`tpreg get root/usb/massStorageReadOnly`"; then
		echo "TP_USB_STORAGE_MODE=ro"
	else
		echo "TP_USB_STORAGE_MODE=rw"
	fi
} > $CONF

# 2. A udev rule that stops a denied class from being set up locally. The
#    rule is regenerated wholesale so that unticking a box really removes it.
{
	echo '# generated by /etc/tp/panels/usb.apply -- do not edit'
	for pair in massStorage:08 printer:07 audio:01 smartcard:0b; do
		name=`echo $pair | cut -d: -f1`
		class=`echo $pair | cut -d: -f2`
		if ! is_true "`tpreg get root/usb/class/$name`"; then
			echo "SUBSYSTEM==\"usb\", ATTR{bInterfaceClass}==\"$class\", ENV{TP_USB_BLOCKED}=\"1\""
		fi
	done
} > $RULES

if [ -d /run/udev/rules.d ]; then
	cp $RULES /run/udev/rules.d/71-tp-usb.rules 2>/dev/null
	udevadm control --reload 2>/dev/null
fi

runtime_set USB_PROTOCOL "$PROTOCOL"

# Redirection itself is the protocol client's job: freerdp gets /usb:on,
# Citrix has its own usb policy file, Horizon has vmware-usbarbitrator. The
# launchers read TP_USB_PROTOCOL out of $CONF when they build their
# command line, so nothing needs restarting here.
exit 0
