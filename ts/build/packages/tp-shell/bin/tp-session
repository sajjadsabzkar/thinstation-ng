#!/bin/bash
# The desktop session: a window manager, a taskbar and the connection manager.
#
# ThinPro composes a session the same way -- a window manager from the
# hptc-wm alternatives group, lxqt-panel for the taskbar, and hptc-kiosk as
# the connection chooser -- rather than starting a desktop environment. Which
# window manager comes up is a registry key here, standing in for the
# alternatives link ThinPro keeps at /etc/alternatives/hptc-wm.
#
# Two things this script has to get right, both learned the hard way:
#
#   1. The session lives exactly as long as the window manager. Everything
#      else is a background job, and the last line waits on the WM.
#
#   2. Closing the connection manager must not leave a bare root window with
#      no way back. The taskbar is always there, and in kiosk mode the
#      connection manager is respawned, because a kiosk with nothing on
#      screen is a hung client as far as the user is concerned.

. /etc/thinstation.global

log() { logger -t tp-session "$*" 2>/dev/null || echo "tp-session: $*" >&2 ; }

# --- which window manager ---------------------------------------------------
# root/wm/name picks it; the priorities mirror ThinPro's alternatives group,
# where kwin_x11 is 60 and openbox is 50. Whatever the registry says, fall
# back to something that is actually installed rather than to a black screen.
WM=`tpreg get root/wm/name 2>/dev/null`

pick_wm() {
	for candidate in "$@"; do
		if which "$candidate" >/dev/null 2>&1; then
			echo "$candidate"
			return 0
		fi
	done
	return 1
}

case "$WM" in
kwin|kwin_x11)	WM_CMD=`pick_wm kwin_x11 openbox xfwm4` ;;
openbox)	WM_CMD=`pick_wm openbox kwin_x11 xfwm4` ;;
*)		WM_CMD=`pick_wm openbox kwin_x11 xfwm4` ;;
esac

if [ -z "$WM_CMD" ]; then
	log "no window manager found, session cannot start"
	exit 1
fi

# What actually ran and why goes to a plain file next to the session pid, so
# that diagnostics can tell "kwin was asked for but openbox is running" apart
# from "openbox was asked for" without reading the journal.
WMSTATE=/var/lib/tp/tmp/session-wm
mkdir -p "`dirname $WMSTATE`" 2>/dev/null
record_wm() {
	# record_wm <running> <reason-or-empty>
	{
		echo "requested=${WM:-default}"
		echo "running=$1"
		echo "fallback_reason=$2"
		echo "time=`date '+%Y-%m-%d %H:%M:%S'`"
	} > "$WMSTATE" 2>/dev/null
}

start_wm() {
	case "$1" in
	kwin_x11)
		# Software rendering is the realistic case on the hardware this
		# image targets, and kwin's OpenGL backend on llvmpipe is unusably
		# slow. KDE_DEBUG keeps KCrash from restarting kwin as a new
		# process behind our back: a crash has to end $wm_pid, or the
		# fallback below could never see it.
		KWIN_COMPOSE=N QT_QUICK_BACKEND=software KDE_DEBUG=1 \
			$1 --replace &
		;;
	*)
		$1 &
		;;
	esac
	wm_pid=$!
}

# A window manager that is running has claimed _NET_SUPPORTING_WM_CHECK on
# the root window. Nothing else in this session sets it.
wm_claimed_root() {
	which xprop >/dev/null 2>&1 || return 1
	xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null | grep -q 'window id'
}

# KWin is the one that can fail on the hardware: old GPUs, missing GL, a
# plugin that does not load. Give it a grace period; if it dies inside it,
# the session carries on with openbox instead of ending at a black screen.
# Everything else in this script waits until the choice is final, so the
# taskbar and connection manager never start under a window manager that is
# about to disappear.
KWIN_GRACE=15

log "window manager: $WM_CMD"
start_wm "$WM_CMD"
fallback_reason=

if [ "$WM_CMD" = kwin_x11 ]; then
	waited=0
	while [ $waited -lt $KWIN_GRACE ]; do
		if ! kill -0 $wm_pid 2>/dev/null; then
			wait $wm_pid
			fallback_reason="kwin_x11 exited with status $? after ${waited}s"
			break
		fi
		wm_claimed_root && break
		sleep 1
		waited=$((waited + 1))
	done
	# Alive at the end of the grace period counts as working: a slow
	# machine is not a broken one.

	if [ -n "$fallback_reason" ]; then
		FALLBACK=`pick_wm openbox xfwm4`
		# Whatever is left of kwin must not hold the window manager
		# selection, or openbox refuses to start.
		pkill -x kwin_x11 2>/dev/null
		if [ -n "$FALLBACK" ]; then
			log "$fallback_reason; falling back to $FALLBACK"
			WM_CMD=$FALLBACK
			start_wm "$WM_CMD"
			which tp-diag-request >/dev/null 2>&1 && tp-diag-request wm-fallback
		else
			log "$fallback_reason and no fallback window manager is installed"
			record_wm none "$fallback_reason"
			exit 1
		fi
	fi
fi
record_wm "$WM_CMD" "$fallback_reason"

# --- root window ------------------------------------------------------------
# Nothing paints the root window without a desktop process, so it would stay
# at the X default stipple. ThinPro's background is a flat colour by default.
BG=`tpreg get root/desktop/background 2>/dev/null`
[ -n "$BG" ] || BG="#2e3436"
case "$BG" in
\#*)	xsetroot -solid "$BG" 2>/dev/null ;;
*)	if [ -r "$BG" ] && which feh >/dev/null 2>&1; then
		feh --bg-scale "$BG" 2>/dev/null
	else
		xsetroot -solid "#2e3436" 2>/dev/null
	fi
	;;
esac

# --- first boot -------------------------------------------------------------
# ThinPro shows its Initial Setup Wizard on a unit that has not been through
# it yet, and records the fact so it does not come back. Run it in the
# foreground: nothing else should start until language and networking have
# been settled.
if [ "`tpreg get root/setup/completed 2>/dev/null`" != "1" ] \
   && which tp-wizard >/dev/null 2>&1; then
	log "first boot, running the setup wizard"
	tp-wizard
fi

# --- taskbar and connection manager ----------------------------------------
# root/product/config is the one switch between the two shapes of session:
#
#   standard  taskbar, and the connection manager as an ordinary window
#   zero      no taskbar; the connection manager is the kiosk sidebar and is
#             brought back whenever it exits, because a kiosk with nothing
#             on screen is a hung client as far as the user is concerned
#
# The connection manager is told which one with --kiosk or --window rather
# than working it out for itself. It used to read root/users/$USER/kioskMode,
# but the session runs as tsuser and the control panel wrote the key under
# ThinPro's user name, "user", so kiosk mode never came up at all.
#
# Changing the configuration in the control panel sends this script SIGUSR1,
# and it tears both down and starts them again in the new shape.

PIDFILE=/var/lib/tp/tmp/session.pid
mkdir -p "`dirname $PIDFILE`" 2>/dev/null
echo $$ > "$PIDFILE" 2>/dev/null
rm -f /var/lib/tp/tmp/session-ending

product_config() {
	case "`tpreg get root/product/config 2>/dev/null`" in
	zero)	echo zero ;;
	*)	echo standard ;;
	esac
}

taskbar_pid=
connmgr_pid=
desktop_pid=
mode=

start_shell() {
	mode=`product_config`
	log "product configuration: $mode"

	# The standard configuration has a desktop behind everything: the
	# wallpaper and a launcher per connection (ThinPro's 25desktop hook).
	# Smart Zero has neither.
	if [ "$mode" = standard ] && which tp-desktop >/dev/null 2>&1; then
		tp-desktop &
		desktop_pid=$!
	fi

	if [ "$mode" = standard ] \
	   && [ "`tpreg get root/desktop/showTaskbar 2>/dev/null`" != "0" ] \
	   && which tp-taskbar >/dev/null 2>&1; then
		tp-taskbar &
		taskbar_pid=$!
	fi

	# The same gate as ThinPro's 92hptc-kiosk hook: only auto-launch when
	# the user right says so.
	if [ "`tpreg get root/users/user/launchConnectionManager 2>/dev/null`" = "1" ] \
	   && which tp-connmgr >/dev/null 2>&1; then
		if [ "$mode" = zero ]; then
			# If it dies, bring it back, but slowly enough that a crash
			# loop does not saturate the machine.
			(
				while kill -0 $wm_pid 2>/dev/null; do
					tp-connmgr --kiosk
					sleep 2
				done
			) &
			connmgr_pid=$!
		elif [ -z "$desktop_pid" ]; then
			# Standard mode normally starts nothing over the desktop:
			# ThinPro shows the wallpaper and the launchers, and the
			# connection manager is one click away in the menu. Without
			# tp-desktop there would be nothing to click, so open it.
			tp-connmgr --window &
			connmgr_pid=$!
		fi
	fi
}

stop_shell() {
	# The kiosk respawn loop is a subshell with tp-connmgr as its child.
	# Kill the child first: the loop then sits in its two-second sleep,
	# which is the window in which it is safe to kill the loop itself.
	for pid in $connmgr_pid $taskbar_pid $desktop_pid; do
		pkill -P $pid 2>/dev/null
		kill $pid 2>/dev/null
		pkill -P $pid 2>/dev/null
	done
	connmgr_pid=
	taskbar_pid=
	desktop_pid=
}

# ThinPro's 25desktop hook: on a fresh client, one sample connection per
# client the image carries, so the desktop is not empty. Once only, and
# never on top of connections someone has already made.
create_sample_connections() {
	[ "`tpreg get root/ConnectionManager/createSampleConnections 2>/dev/null`" = 1 ] || return 0
	if [ -z "`tpreg connections 2>/dev/null`" ]; then
		for type in firefox freerdp horizon ica; do
			# Only for clients that are really in the image: pkg hands
			# a connection to /etc/init.d/<type>.
			[ -e /etc/init.d/$type ] || [ -L /etc/init.d/$type ] || continue
			label=`tpreg get root/ConnectionType/$type/coreSettings/label 2>/dev/null`
			tpreg newconn $type "$label" >/dev/null 2>&1 \
				&& log "sample connection: $type ($label)"
		done
	fi
	tpreg set root/ConnectionManager/createSampleConnections 0 2>/dev/null
}

# A fresh login is a user-mode login. Administrator mode left over from an
# earlier session on this boot would otherwise stop autostart from running
# and leave the control panel unlocked.
tpreg set "root/users/${USER:-user}/adminMode" 0 2>/dev/null

reload=0
trap 'reload=1' USR1

create_sample_connections
start_shell

# --- autostart connections --------------------------------------------------
if which tp-autostart >/dev/null 2>&1; then
	tp-autostart &
fi

# `wait` returns early when a trapped signal arrives, so this loop is what
# lets a control-panel change reach a running session.
while :; do
	if ! kill -0 $wm_pid 2>/dev/null; then
		# KWin that survived its grace period can still die later, on the
		# first effect or the first window that trips a GPU bug. Carry on
		# under openbox rather than ending the session under the user.
		# Not when the machine is going down, or when something ended the
		# session on purpose (it drops /var/lib/tp/tmp/session-ending).
		ending=0
		[ -e /var/lib/tp/tmp/session-ending ] && ending=1
		case "`systemctl is-system-running 2>/dev/null`" in stopping) ending=1 ;; esac
		if [ $ending = 0 ] && [ "$WM_CMD" = kwin_x11 ] \
		   && FALLBACK=`pick_wm openbox xfwm4`; then
			fallback_reason="kwin_x11 exited with status ${wm_status:-?} during the session"
			log "$fallback_reason; falling back to $FALLBACK"
			pkill -x kwin_x11 2>/dev/null
			WM_CMD=$FALLBACK
			start_wm "$WM_CMD"
			record_wm "$WM_CMD" "$fallback_reason"
			# The kiosk respawn loop watches the old pid; restart it.
			stop_shell
			start_shell
			which tp-diag-request >/dev/null 2>&1 && tp-diag-request wm-fallback
			continue
		fi
		break
	fi
	wait $wm_pid
	wm_status=$?
	if [ $reload = 1 ]; then
		reload=0
		old=$mode
		stop_shell
		start_shell
		# Entering zero configuration means the default connection is now
		# supposed to be up; nothing else would start it before a relogin.
		if [ "$old" != zero ] && [ "$mode" = zero ] \
		   && which tp-autostart >/dev/null 2>&1; then
			tp-autostart &
		fi
	fi
done

stop_shell
rm -f "$PIDFILE" /var/lib/tp/tmp/session-ending
