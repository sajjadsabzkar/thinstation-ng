/* The ThinPro look, taken from the real thing.
 *
 * Every value below is lifted from HP ThinPro 8.1's own
 * /usr/share/hptc-control-panel/styles/default.qss, so that the connection
 * manager, the control panel, the panels and the setup wizard read as one
 * product rather than as four Qt dialogs.
 *
 *   #0096D6   HP blue: selection, primary buttons
 *   #CCCCCC   header and footer bars
 *   #676767   text on those bars
 *   #333333   body text
 *   #F8F8F8   panel background
 *   #E8E8E8   hover
 *   #F2F2F2   disabled fill
 *
 * ThinPro sets font-family "HP Simplified" at weight 25 (QFont::Light).
 * That font is not redistributable, so the family list below falls through
 * to what the image actually carries. Liberation Sans is metrically close
 * enough that the layouts hold.
 */

* {
    font-family: "HP Simplified", "Liberation Sans", "DejaVu Sans", sans-serif;
}

QWidget {
    color: #333333;
    background: #F8F8F8;
}

QWidget:disabled {
    color: #ADADAD;
}

/* ---- headers and footers ------------------------------------------------ */

QFrame#tpHeader {
    background: #CCCCCC;
    color: #676767;
    min-height: 50px;
    max-height: 50px;
    margin: 0;
}

QFrame#tpHeader QLabel {
    background: transparent;
    color: #676767;
    font-size: 18px;
}

QFrame#tpHeader QLabel#tpTitle {
    font-size: 20px;
}

QFrame#tpFooter {
    background: #CCCCCC;
    padding: 5px;
    padding-right: 20px;
}

/* The back arrow in ThinPro's ConfigListHeader. */
QFrame#tpHeader QPushButton {
    background: rgba(0, 0, 0, 0.1);
    color: white;
    border: none;
    border-radius: 3px;
    font-size: 18px;
    min-height: 32px;
    min-width: 32px;
}

QFrame#tpHeader QPushButton:hover {
    background: rgba(0, 0, 0, 0.15);
}

QFrame#tpHeader QPushButton:pressed {
    background: rgba(0, 0, 0, 0.2);
}

/* The search field sits on the grey header with only an underline. */
QLineEdit#tpSearch {
    color: #333333;
    background: transparent;
    selection-background-color: #0096D6;
    selection-color: white;
    border: none;
    border-bottom: 1px solid #333333;
    font-size: 15px;
    padding: 2px;
}

/* ---- buttons ------------------------------------------------------------ */

/* Primary: flat HP blue, in the footer. */
QFrame#tpFooter QAbstractButton,
QPushButton[tpPrimary="true"] {
    border: none;
    font-size: 16px;
    color: white;
    background: #0096D6;
    padding: 5px 15px 5px 15px;
    border-radius: 3px;
    min-height: 26px;
}

QFrame#tpFooter QAbstractButton:pressed,
QPushButton[tpPrimary="true"]:pressed {
    color: #CCCCCC;
    background: #F2F2F2;
}

QFrame#tpFooter QAbstractButton:disabled,
QPushButton[tpPrimary="true"]:disabled {
    color: #CCCCCC;
    background: #F2F2F2;
}

/* Secondary: outlined, the style ThinPro uses for launchModalButton. */
QPushButton {
    background: white;
    color: #333333;
    font-size: 16px;
    padding: 6px 16px 6px 16px;
    border: 2px solid #CCCCCC;
    border-radius: 3px;
    min-height: 24px;
}

QPushButton:hover {
    background: #F2F2F2;
}

QPushButton:pressed {
    background: rgba(0, 0, 0, 0.1);
}

QPushButton:disabled {
    color: #CCCCCC;
    background: #F2F2F2;
    border: 2px solid #F2F2F2;
}

QPushButton:default {
    border: 2px solid #0096D6;
    background: #0096D6;
    color: white;
}

QPushButton:default:pressed {
    border: 2px solid #F2F2F2;
    background: #F2F2F2;
    color: #CCCCCC;
}

/* ---- lists -------------------------------------------------------------- */

QListWidget, QListView, QTreeWidget, QTableWidget {
    background: white;
    border: none;
    font-size: 16px;
}

QListWidget::item, QListView::item {
    height: 50px;
    padding-right: 10px;
    padding-left: 10px;
}

QListWidget::item:hover, QListView::item:hover {
    background: #E8E8E8;
}

QListWidget::item:selected, QListView::item:selected {
    background: #0096D6;
    color: white;
}

/* The home page's category rows are taller and carry a 28px title. */
QListWidget#tpCategories::item {
    height: 84px;
}

QLabel#tpCategoryTitle {
    font-size: 28px;
    font-weight: 300;
    background: transparent;
}

QLabel#tpCategoryItems {
    font-size: 15px;
    color: #676767;
    background: transparent;
}

/* ---- form controls ------------------------------------------------------ */

QLineEdit, QComboBox, QSpinBox {
    background: white;
    border: 2px solid #CCCCCC;
    border-radius: 3px;
    padding: 4px;
    font-size: 15px;
    min-height: 22px;
    selection-background-color: #0096D6;
    selection-color: white;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 2px solid #0096D6;
}

QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled {
    background: #F2F2F2;
    color: #ADADAD;
    border: 2px solid #F2F2F2;
}

/* No QComboBox::drop-down rule: styling that subcontrol without also
   giving ::down-arrow an image makes Qt drop the arrow entirely, and every
   combo box then looks like a text field. Fusion's own arrow is fine. */

QComboBox QAbstractItemView {
    background: white;
    border: 2px solid #E8E8E8;
    selection-background-color: #0096D6;
    selection-color: white;
}

QCheckBox, QRadioButton {
    background: transparent;
    font-size: 15px;
    spacing: 8px;
}

QLabel {
    background: transparent;
    font-size: 15px;
}

QGroupBox {
    border: 1px solid #CCCCCC;
    border-radius: 3px;
    margin-top: 14px;
    padding-top: 8px;
    font-size: 15px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px 0 4px;
    color: #676767;
}

QSlider::groove:horizontal {
    height: 4px;
    background: #CCCCCC;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #0096D6;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: white;
    border: 2px solid #0096D6;
    width: 14px;
    margin: -6px 0;
    border-radius: 8px;
}

QTabWidget::pane {
    border: none;
    background: #F8F8F8;
}

QTabBar::tab {
    background: #E8E8E8;
    color: #333333;
    padding: 8px 18px 8px 18px;
    border: none;
    font-size: 15px;
}

QTabBar::tab:selected {
    background: #F8F8F8;
    border-bottom: 3px solid #0096D6;
}

/* ---- taskbar ------------------------------------------------------------ */

/* ThinPro 8.1's panel: a light strip with a hairline on top, HP blue
 * glyphs, the hamburger at the left, the tray and a two-line clock at the
 * right. Same palette as the kiosk sidebar. */
QWidget#tpTaskbar {
    background: #F2F2F2;
    border-top: 1px solid #C6C6C6;
}

QPushButton#tpTaskbarMenu {
    background: transparent;
    border: none;
    border-radius: 0;
    color: #0096D6;
    font-size: 24px;
    min-width: 54px;
    max-width: 54px;
    min-height: 44px;
    padding: 0px;
}

QPushButton#tpTaskbarMenu:hover,
QPushButton#tpTaskbarTray:hover {
    background: #E0E0E0;
}

QPushButton#tpTaskbarMenu:pressed,
QPushButton#tpTaskbarTray:pressed {
    background: #D4D4D4;
}

QPushButton#tpTaskbarTray {
    background: transparent;
    border: none;
    border-radius: 0;
    color: #0F6FA8;
    font-size: 19px;
    min-width: 38px;
    max-width: 38px;
    min-height: 44px;
    padding: 0px;
}

/* No address: the network glyph goes red. */
QPushButton#tpTaskbarTray[tpOffline="true"] {
    color: #C0392B;
}

QLabel#tpTaskbarClock {
    background: transparent;
    color: #0F6FA8;
    font-size: 12px;
    qproperty-alignment: AlignCenter;
    padding: 0px 4px 0px 8px;
}

QMenu {
    background: white;
    color: #333333;
    font-size: 16px;
    border: 2px solid #E8E8E8;
}

QMenu::item {
    border: none;
    padding: 8px 16px 8px 24px;
}

QMenu::item:selected {
    background: #E8E8E8;
}

QMenu::separator {
    height: 1px;
    background: #E8E8E8;
    margin: 4px 0 4px 0;
}

/* ---- status ------------------------------------------------------------- */

QLabel#tpStatusOk    { color: #2E7D32; }
QLabel#tpStatusWarn  { color: #B26500; }
QLabel#tpStatusFail  { color: #B00020; }

QProgressBar {
    border: none;
    background: #E8E8E8;
    height: 6px;
    border-radius: 3px;
    text-align: center;
}

QProgressBar::chunk {
    background: #0096D6;
    border-radius: 3px;
}

/* ===========================================================================
 * Taken from screenshots of ThinPro 8.1 running, not from its stylesheet.
 *
 * default.qss describes the control panel. It says nothing about the setup
 * wizard, the kiosk sidebar or the dialogs, and those turn out not to follow
 * it: the wizard is a two-colour split with a slate right half, the dialogs
 * sit on a warm grey rather than #F8F8F8, and the sidebar is a 60px strip,
 * not a drawer. The values below are read off the running product.
 * =========================================================================== */

/* ---- dialogs ------------------------------------------------------------- */

/* Warm grey, not the panel white. Visible behind the Compatibility Check and
 * the Configuration Wizard. */
QDialog {
    background: #EFEDEA;
}

QDialog QLabel {
    background: transparent;
}

/* ---- the kiosk sidebar --------------------------------------------------- */

/* A 60px strip down the right edge. In Smart Zero this is the entire shell:
 * there is no taskbar and no desktop behind it. */
QWidget#tpKioskPanel {
    background: #F2F2F2;
    border-left: 1px solid #C6C6C6;
}

/* The hamburger sits in its own slightly darker cell at the top. */
QPushButton#tpKioskMenuButton {
    background: #E4E4E4;
    border: none;
    border-bottom: 1px solid #C6C6C6;
    color: #0096D6;
    font-size: 22px;
    min-height: 44px;
    max-height: 44px;
    padding: 0px;
}

QPushButton#tpKioskMenuButton:hover {
    background: #D8D8D8;
}

/* The tray icons down the bottom of the strip. */
QPushButton#tpTrayButton {
    background: transparent;
    border: none;
    color: #0F6FA8;
    font-size: 17px;
    min-height: 38px;
    max-height: 38px;
    padding: 0px;
}

QPushButton#tpTrayButton:hover {
    background: #E0E0E0;
}

QLabel#tpKioskClock {
    color: #0F6FA8;
    font-size: 11px;
    qproperty-alignment: AlignCenter;
    padding: 2px 0px 6px 0px;
}

/* ---- the sidebar menu ---------------------------------------------------- */

/* Roomier than an ordinary Qt menu: this one is meant to be hit with a
 * finger on a kiosk, and ThinPro gives each row about 48px. */
QMenu#tpKioskMenu {
    background: #FFFFFF;
    border: 1px solid #BFBFBF;
    padding: 0px;
}

QMenu#tpKioskMenu::item {
    background: transparent;
    color: #1A1A1A;
    font-size: 15px;
    padding: 14px 28px 14px 16px;
    min-height: 22px;
}

QMenu#tpKioskMenu::item:selected {
    background: #E8E8E8;
}

QMenu#tpKioskMenu::separator {
    height: 1px;
    background: #4A4A4A;
    margin: 4px 0px;
}

QMenu#tpKioskMenu::icon {
    padding-left: 14px;
}

/* The search box pinned to the bottom of that menu. */
QLineEdit#tpMenuSearch {
    background: #6E6E6E;
    border: none;
    color: #FFFFFF;
    font-style: italic;
    font-size: 15px;
    padding: 10px 12px;
}

/* ---- the setup wizard ---------------------------------------------------- */

/* Left half: white, the form. */
QWidget#tpWizardForm {
    background: #FFFFFF;
}

QLabel#tpWizardQuestion {
    color: #0096D6;
    font-size: 30px;
    font-weight: 300;
}

/* Right half: slate, the illustration and the step indicator. */
QWidget#tpWizardAside {
    background: #4C5680;
}

QLabel#tpWizardHeadline {
    color: #FFFFFF;
    font-size: 36px;
    font-weight: 300;
    qproperty-alignment: AlignCenter;
}

QLabel#tpWizardSubtitle {
    color: #C6CBDF;
    font-size: 16px;
    qproperty-alignment: AlignCenter;
}

QLabel#tpWizardBrand {
    color: #D5D9E6;
    font-size: 22px;
    font-weight: 300;
}

/* The step pill: a darker blue bar carrying a dot per step. */
QFrame#tpWizardSteps {
    background: #0A6E9E;
    border-radius: 6px;
    min-height: 54px;
}

QLabel#tpWizardStepName {
    color: #FFFFFF;
    font-size: 19px;
    font-weight: bold;
    background: transparent;
}

QLabel#tpWizardStepDot {
    color: #FFFFFF;
    font-size: 15px;
    background: transparent;
}

/* The language page and the finish page are full-width white instead. */
QWidget#tpWizardCover {
    background: #FFFFFF;
}

QPushButton#tpLanguageChoice {
    background: transparent;
    border: none;
    color: #0096D6;
    font-size: 26px;
    padding: 6px 14px;
}

QPushButton#tpLanguageChoice:hover {
    color: #007CB0;
}

QPushButton#tpLanguageChoice[tpSelected="true"] {
    border-bottom: 3px solid #0096D6;
}

QLabel#tpDoneMessage {
    color: #4E9A3D;
    font-size: 40px;
    qproperty-alignment: AlignCenter;
}

/* ---- the compatibility check -------------------------------------------- */

/* One row per check: a status glyph, the name in bold, the detail under it.
 * ThinPro draws even the failures in blue rather than red - the dialog is
 * telling you what the hardware is, not warning you off it. */
QLabel#tpCheckName {
    color: #1A1A1A;
    font-size: 15px;
    font-weight: bold;
}

QLabel#tpCheckDetail {
    color: #6B6B6B;
    font-size: 13px;
}

QLabel#tpCheckGlyph {
    color: #0F6FA8;
    font-size: 24px;
    qproperty-alignment: AlignCenter;
}

/* ---- the control panel home --------------------------------------------- */

/* White body under the grey search strip, two columns of categories. */
QWidget#tpHomeBody {
    background: #FFFFFF;
}

QLabel#tpCategoryIcon {
    color: #0F6FA8;
    font-size: 26px;
}

/* ---- the control panel's category view ---------------------------------- */

/* Read off the running product: the control panel is one window, not a
 * launcher. A category shows its panels down a white sidebar with the
 * selected one as a solid blue band, and that panel's form fills the rest. */

QPushButton#tpBackButton {
    background: #BFBFBF;
    border: none;
    border-radius: 4px;
    color: #4A4A4A;
    font-size: 26px;
    min-width: 54px;
    min-height: 42px;
    padding-bottom: 4px;
}

QPushButton#tpBackButton:hover {
    background: #B0B0B0;
}

/* The category name doubles as a way to move between categories. Drawn flat
 * on the grey header rather than as a boxed combo. */
QPushButton#tpCategoryPicker {
    background: transparent;
    border: none;
    color: #4A4A4A;
    font-size: 26px;
    padding: 0px 8px;
    text-align: left;
}

QPushButton#tpCategoryPicker:hover {
    color: #1A1A1A;
}

/* Qt draws its own arrow on a button that has a menu. The caret is already
 * in the text, so hide it. */
QPushButton#tpCategoryPicker::menu-indicator {
    image: none;
    width: 0px;
}

QPushButton#tpCategoryPicker QMenu {
    background: #FFFFFF;
    border: 1px solid #BFBFBF;
    font-size: 17px;
}

QListWidget#tpPanelList {
    background: #FFFFFF;
    border: none;
    border-right: 1px solid #DDDDDD;
    outline: none;
}

QListWidget#tpPanelList::item {
    color: #333333;
    font-size: 17px;
    padding-left: 18px;
    padding-right: 12px;
    border: none;
}

QListWidget#tpPanelList::item:hover {
    background: #EFEFEF;
}

/* The selected row is a full-bleed HP blue band with white text - the one
 * strong colour anywhere in the window. */
QListWidget#tpPanelList::item:selected {
    background: #0096D6;
    color: #FFFFFF;
}

/* The pane beside it is a warm off-white, not the panel grey. */
QStackedWidget#tpPanelStack {
    background: #F7F4F1;
}

QStackedWidget#tpPanelStack QWidget {
    background: #F7F4F1;
}

QStackedWidget#tpPanelStack QLineEdit,
QStackedWidget#tpPanelStack QComboBox,
QStackedWidget#tpPanelStack QSpinBox {
    background: #FFFFFF;
}
